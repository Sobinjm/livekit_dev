# PostgreSQL Database Configuration
# These values should be modified to match your local PostgreSQL setup

# If you're using a PostgreSQL instance set up with default values, you might use:
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=video_conference_app
PGHOST=localhost
PGPORT=5432

# The full connection string used by the app
DATABASE_URL=postgres://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}

# Instructions:
# 1. Create a copy of this file named .env
# 2. Update the values above with your local PostgreSQL credentials
# 3. Create a database named 'video_conference_app' in your PostgreSQL instance
# 4. Run `npm run db:push` to create the tables