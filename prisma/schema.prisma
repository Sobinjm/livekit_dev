// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int           @id @default(autoincrement())
  username    String        @unique
  password    String
  display_name String
  email       String?       @unique
  created_at  DateTime?     @default(now())
  updated_at  DateTime?     @updatedAt
  meetings    Meeting[]     @relation("UserToMeeting")
  participants Participant[]
  messages    Message[]

  @@map("users")
}

model Meeting {
  id           Int           @id @default(autoincrement())
  meeting_id   String        @unique @map("meeting_id")
  name         String        @map("name")
  description  String?
  start_time   DateTime?     @default(now())
  end_time     DateTime?
  is_recording Boolean       @default(false) @map("is_recording")
  recording_url String?
  created_by   Int           @map("created_by")
  creator      User          @relation("UserToMeeting", fields: [created_by], references: [id])
  created_at   DateTime?     @default(now()) @map("created_at")
  updated_at   DateTime?     @updatedAt
  participants Participant[]
  messages     Message[]

  @@map("meetings")
}

model Participant {
  id          Int       @id @default(autoincrement())
  user_id     Int       @map("user_id")
  meeting_id  String    @map("meeting_id")
  is_host     Boolean   @default(false) @map("is_host")
  joined_at   DateTime  @default(now()) @map("joined_at")
  left_at     DateTime?
  user        User      @relation(fields: [user_id], references: [id])
  meeting     Meeting   @relation(fields: [meeting_id], references: [meeting_id])

  @@unique([user_id, meeting_id])
  @@map("participants")
}

model Message {
  id          Int       @id @default(autoincrement())
  content     String
  sender_id   Int       @map("sender_id")
  meeting_id  String    @map("meeting_id")
  sent_at     DateTime  @default(now())
  sender      User      @relation(fields: [sender_id], references: [id])
  meeting     Meeting   @relation(fields: [meeting_id], references: [meeting_id])

  @@map("messages")
}